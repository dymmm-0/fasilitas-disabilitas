{"nodes": [{"id": "agents_akseskita", "label": "AksesKita (Laravel 13 + Vue 3 SPA)", "file_type": "document", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Agent-facing project summary: one page must convey that facility data is real (1.117 OSM rows), that decisions are persisted, and which invariants may not be broken."}, {"id": "agents_facilities_api", "label": "GET /api/facilities Public Facilities Endpoint", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Facility data must come from the API, never from a client-side array, so the backend keeps a single source of truth."}, {"id": "agents_rejected_row_exclusion", "label": "Rejected Facilities Excluded From Public Query", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exclusion happens in the backend query, not the UI, so rejected rows can never leak into map, list, search, filters or detail while remaining in the database for audit; they surface only in the auth-only 'selesai' bucket."}, {"id": "agents_verification_queue_api", "label": "GET /api/verification-queue Merged Queue", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Merging dataset rows that still need checking with citizen submissions server-side lets both kinds of record be decided from the same page instead of two disjoint inboxes."}, {"id": "agents_facility_decision_endpoint", "label": "POST /api/facilities/{id}/verification", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Facility decisions write only verification columns, never the eight accessibility indicators, and never mass-update statuses."}, {"id": "agents_submission_decision_endpoint", "label": "POST /api/submissions/{id}/decision", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Submission decisions are a separate endpoint from facility decisions so the two subjects keep independent lifecycles and audit history."}, {"id": "agents_composable_singleton_state", "label": "Module-Level Singleton Composables", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deliberate singleton scope (useFacilities, useVerification, useSubmissions) so map, card list and dashboard read one array without a state-management library; useSubmissions stays write-only."}, {"id": "agents_layout_switching", "label": "route.meta.layout Admin/Public Split", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One codebase serves two audiences; App.vue only switches layout, so admin chrome is never duplicated per page."}, {"id": "agents_auth_middleware_enforcement", "label": "Auth Middleware As The Real Access Gate", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Hiding admin menu links is cosmetic only; access must be enforced by the auth middleware in routes/web.php, never by the frontend alone."}, {"id": "agents_status_label_and_glyph", "label": "Status Rendered As Label Plus Glyph", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Colour alone fails colour-blind and screen-reader users, so every status renders label and glyph through StatusPill."}, {"id": "agents_meta_constant_sync", "label": "Frontend/Backend Constant Sync Contract", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "QUEUE_BUCKETS / QUEUE_TYPES / NEEDS_VERIFICATION in meta.js must mirror VerificationQueueController::BUCKETS, submissions.type and Facility::NEEDS_VERIFICATION; drift silently breaks queue filters, so no new status may be declared inline in a component."}, {"id": "agents_queue_submission_delay", "label": "Queued Submission Delay (QueueSubmission, 60s)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'queued' is a deliberate holding state excluded from the queue and from Submission::DECIDABLE_STATUSES; the job's failed() releases the row to 'menunggu' so submissions cannot be stranded without a worker."}, {"id": "agents_private_proof_storage", "label": "Private Local Disk Proof Storage", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proof photos are served only through an auth-protected route because they may contain sensitive citizen-submitted imagery."}, {"id": "agents_verification_audit_2026_10_22", "label": "Facility Verification Audit (2026-10-22)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "All 1.117 rows were 'pending' with verified_at, verification_method and evidence_url empty, so 'pending' genuinely means never checked; therefore no migration may mass-update statuses and name/category/address completeness is not evidence of verification."}, {"id": "agents_spa_fallback_up_exclusion", "label": "SPA Fallback With /up Exclusion", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "routes/web.php catches every path as a SPA fallback, so /up must stay excluded or the Laravel health check stops answering."}, {"id": "agents_hero_crossfade_slider", "label": "Homepage Hero Crossfade Photo Slider", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six-second crossfade dims under prefers-reduced-motion; images must be local files (never hotlinked) added by dropping a file in public/images/hero and one heroSlides entry."}, {"id": "agents_design_tokens_app_css", "label": "Design Tokens In resources/css/app.css", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Design tokens were translated from the TemplateDesignWeb handoff into class-based CSS; Tailwind 4 is wired but there is no tailwind.config.js, so new styling belongs in app.css, not utility sprawl."}, {"id": "agents_verification_only_checks", "label": "Only Three Accepted Verification Checks", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No CI, static analysis or JS test runner exists, so php artisan test, pint --test and a successful npm run build are the only gates; a green PHP suite must not be read as frontend coverage."}], "edges": [{"source": "agents_akseskita", "target": "readme_akseskita", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "AGENTS.md", "source_location": null, "weight": 1.