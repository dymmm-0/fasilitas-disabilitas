{"nodes": [{"id": "agents_akseskita_project", "label": "AksesKita \u2014 Disability-Friendly Facility Mapping SPA", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_dummy_data_frontend_only", "label": "Dummy-Data-Only Frontend Phase", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No backend features, DB schema, or real auth yet; the whole app is driven from resources/js/data so UX and design can be verified before persistence exists."}, {"id": "agents_composer_run_dev", "label": "composer run dev (serve + queue:listen + Vite)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_npm_run_build", "label": "npm run build", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_artisan_test", "label": "php artisan test (PHPUnit 12)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_vendor_bin_pint", "label": "vendor/bin/pint (PHP formatting)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_composer_run_setup", "label": "composer run setup (one-time install with migrate --force)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_vue_spa_architecture", "label": "Vue 3 <script setup> SPA mounted on Blade #app", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_module_level_composables", "label": "Module-Level Singleton Composables", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "State is module-level (singleton) on purpose: one facilities array must feed map, card list, and admin dashboard from the same source instead of per-component copies."}, {"id": "agents_use_facilities", "label": "useFacilities", "file_type": "code", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_use_submissions", "label": "useSubmissions", "file_type": "code", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_meta_js_status_source", "label": "meta.js as Single Source for Status Labels and Glyphs", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Statuses are added centrally in meta.js, never inline in components, so label/glyph pairs cannot drift between dashboard, cards, and map."}, {"id": "agents_status_pill_label_glyph", "label": "StatusPill: Label + Glyph, Never Colour Alone", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Colour-only status encoding fails for colour-blind and screen-reader users, so verification state always carries a text label and a glyph."}, {"id": "agents_rust_accent_contrast_rule", "label": "Rust as Sole Accent, Kept Off Small Text on Ink", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "--rust is the only accent colour; on --ink backgrounds it must not be used for small text because the pair does not meet contrast."}, {"id": "agents_leaflet_divicon_markers", "label": "Leaflet L.divIcon Square Markers (no image assets)", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "agents_card_list_keyboard_path", "label": "Card List as the Keyboard/Screen-Reader Path to the Map", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An interactive Leaflet map is not keyboard- or screen-reader-navigable, so the same facilities array is rendered as a focusable card list."}, {"id": "agents_app_css_design_tokens", "label": "Design Tokens and Component Classes in resources/css/app.css", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Class-based CSS rather than Tailwind utilities; Tailwind 4 is wired up but there is no tailwind.config.js."}, {"id": "agents_bunny_fonts_build_time", "label": "bunny() Font Download at Build Time", "file_type": "concept", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fonts are self-hosted instead of using the prototype's Google Fonts <link>, so a build without network access fails."}, {"id": "agents_templatedesignweb_reference", "label": "TemplateDesignWeb as Read-Only Design Reference", "file_type": "rationale", "source_file": "AGENTS.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The bundle is a design reference, not production code: 