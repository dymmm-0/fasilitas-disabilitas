{"nodes": [{"id": "readme_akseskita", "label": "AksesKita", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Core premise: before visiting a public facility the question is not 'where is it' but 'can I enter and use it'. AksesKita puts scattered accessibility information into one map, one data schema and one database."}, {"id": "readme_accessibility_indicators", "label": "Five Accessibility Indicators", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_belum_vs_tidak", "label": "belum Is Not tidak (unknown != no)", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A facility whose toilet was never inspected must not be treated as having no accessible toilet. Therefore 'belum' never counts as 'available' in filters and lowers the data completeness percentage; database enum defaults to unknown so absent evidence never reads as 'no'."}, {"id": "readme_osm_medan_dataset", "label": "Medan OpenStreetMap Facility Dataset", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_idempotent_import", "label": "facilities:import Idempotent Import Command", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rows with an existing external_id are not recreated and rows whose verification_status is not pending are skipped, not overwritten; transactions per 200 rows, per-row CSV report, and never deletes data."}, {"id": "readme_category_map", "label": "Facility::CATEGORY_MAP", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_facility_model", "label": "Facility Model", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_verification_queue_controller", "label": "VerificationQueueController", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_facility_controller_verify", "label": "FacilityController::verify", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_submission_controller", "label": "SubmissionController", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_verification_events", "label": "verification_events Audit Trail", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One row per decision for either subject (submission_id or facility_id, both nullable); the old table name was submission_events. It records decisions, not before/after attribute values."}, {"id": "readme_use_verification", "label": "useVerification Composable", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_session_auth", "label": "Laravel Session Authentication", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cookie-based session auth (not API tokens) with XSRF-TOKEN cookie; the Vue route guard exists only for UX, real enforcement is the auth middleware, and /admin and /verifikasi redirect guests to /masuk."}, {"id": "readme_single_admin_role_shortcut", "label": "Single Admin Role Shortcut", "file_type": "rationale", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "There is only one role today, so 'admin role' means 'logged in'; add a role column and Gate when a second staff role (verifikator) is actually needed. Marked as a shortcut in app/Models/User.php."}, {"id": "readme_data_completeness", "label": "Data Completeness Percentage", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_stale_days_flag", "label": "STALE_DAYS 180-day 'Perlu diperbarui' Flag", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "readme_test_suite", "label": "PHPUnit Test Suite (39 tests, 317 assertions)", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only PHP is tested (AksesKitaTest, FacilityImportTest, AuthTest, SubmissionTest, VerificationQueueTest plus Laravel examples); there are no Vue tests, e2e tests, JS linter or CI, so a passing PHP suite does not mean frontend changes are tested."}, {"id": "readme_sdg_alignment", "label": "SDG 10 and SDG 11 Alignment", "file_type": "concept", "source_file": "README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stated as conceptual only: no social impact measurement, user counts or field verification can be claimed."}], "edges": [{"source": "readme_akseskita", "