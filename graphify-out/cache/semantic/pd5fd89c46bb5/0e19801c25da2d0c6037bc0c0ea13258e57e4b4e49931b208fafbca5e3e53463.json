ontributor": null, "rationale": "There is exactly one accent hue; introducing a second would dissolve the restraint that is the design."}, {"id": "templatedesignweb_design_handoff_atelier_tide_readme_zero_radii_rule", "label": "Zero Border Radius Rule", "file_type": "rationale", "source_file": "TemplateDesignWeb/design_handoff_atelier_tide/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Cards, buttons, images, badges and inputs are hard-edged; only the scrollbar thumb and timeline dots are round, so adding radius during implementation breaks the system."}, {"id": "templatedesignweb_design_handoff_atelier_tide_readme_offset_shadow", "label": "Hard 24px Rust Offset Shadow (hero image only)", "file_type": "rationale", "source_file": "TemplateDesignWeb/design_handoff_atelier_tide/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One shadow in the whole design: box-shadow 24px 24px 0 #a8542a, zero blur. Everything else separates with 1px borders and flat background shifts."}, {"id": "templatedesignweb_design_handoff_atelier_tide_readme_font_triad", "label": "Syne / Inter / DM Mono Type Triad", "file_type": "concept", "source_file": "TemplateDesignWeb/design_handoff_atelier_tide/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "templatedesignweb_design_handoff_atelier_tide_readme_scroll_reveal", "label": "Scroll Reveal (.reveal + one-shot IntersectionObserver)", "file_type": "concept", "source_file": "TemplateDesignWeb/design_handoff_atelier_tide/README.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fade-and-rise over 0.8s is one-shot (class .in is never removed) so the page feels slow and deliberate; the prototype does not honour prefers-reduced-motion."}, {"id": "tem